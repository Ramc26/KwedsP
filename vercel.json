{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/i/e4p8n1",
      "destination": "/i/w7k2m9",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "c", "value": "e4p8n1" }],
      "destination": "/i/w7k2m9",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "c", "value": "w7k2m9" }],
      "destination": "/i/w7k2m9",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/i/w7k2m9", "destination": "/index.html" },
    { "source": "/i/e4p8n1", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/og-(wedding|reception).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/hero-icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
